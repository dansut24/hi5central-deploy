COMPOSE_PROFILES=itsm,rmm,admin,docs
COMPOSE_PROJECT_NAME=hi5central-prod
RELEASE_GATEWAY_CONTAINER_NAME=hi5central-next-prod-gateway
RELEASE_EDGE_NETWORK=hi5central
DEPLOYMENT_MODE=managed
RUNTIME_ENVIRONMENT=live
FEATURE_MODE=controlled
TENANCY_MODE=single
ROOT_DOMAIN=hi5central.com
PRIMARY_TENANT_SLUG=hi5central
BACKGROUND_WORKERS_ENABLED=true

POSTGRES_DB=hi5central
POSTGRES_USER=hi5central
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

MFA_ENCRYPTION_KEY=64_HEX_CHARACTERS
RMM_RECOVERY_KEY_ENCRYPTION_KEY=64_HEX_CHARACTERS
CONNECT_CODE_HMAC_KEY=64_HEX_CHARACTERS
TURN_SHARED_SECRET=64_HEX_CHARACTERS
TURN_REALM=hi5central.com
TURN_EXTERNAL_IP=

APP_URL=https://hi5central.com
PORTAL_URL=https://hi5central.com/portal
RMM_URL=https://rmm.hi5central.com
ADMIN_URL=https://admin.hi5central.com
API_URL=https://api.hi5central.com
DOWNLOADS_URL=https://downloads.hi5central.com
HELP_URL=https://help.hi5central.com
TURN_URL=turn:turn.hi5central.com:3478
TURN_HOST=turn.hi5central.com
MARKETING_URL=https://hi5central.com
COOKIE_DOMAIN=.hi5central.com

ITSM_ADDRESS=hi5central.com
RMM_ADDRESS=rmm.hi5central.com
ADMIN_ADDRESS=admin.hi5central.com
API_ADDRESS=api.hi5central.com
DOWNLOADS_ADDRESS=downloads.hi5central.com
HELP_ADDRESS=help.hi5central.com
ACME_EMAIL=admin@hi5central.com

GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
TURN_LISTEN_PORT=3478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200

CONTROL_SERVER_IMAGE=ghcr.io/dansut24/hi5central-control-server:prod
ITSM_IMAGE=ghcr.io/dansut24/hi5central-itsm:prod
RMM_IMAGE=ghcr.io/dansut24/hi5central-rmm:prod
ADMIN_IMAGE=ghcr.io/dansut24/hi5central-admin:prod
DOCS_IMAGE=ghcr.io/dansut24/hi5central-docs:prod

LICENSING_SERVER_URL=https://licensing.hi5central.com
LICENSING_PUBLIC_KEY_PEM=
LICENSING_PRIVATE_KEY_PEM=
RELEASE_OPERATOR_TOKEN=64_HEX_CHARACTERS
LICENSING_REFRESH_INTERVAL_MS=43200000
LICENSING_INITIAL_REFRESH_DELAY_MS=30000
