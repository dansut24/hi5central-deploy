COMPOSE_PROFILES=itsm,rmm,admin
COMPOSE_PROJECT_NAME=hi5central-uat
RELEASE_GATEWAY_CONTAINER_NAME=hi5central-uat-gateway
RELEASE_EDGE_NETWORK=hi5central
DEPLOYMENT_MODE=managed
RUNTIME_ENVIRONMENT=uat
FEATURE_MODE=controlled
TENANCY_MODE=single
ROOT_DOMAIN=hi5central.com
PRIMARY_TENANT_SLUG=uat
BACKGROUND_WORKERS_ENABLED=true

POSTGRES_DB=hi5central
POSTGRES_USER=hi5central
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

MFA_ENCRYPTION_KEY=64_HEX_CHARACTERS
RMM_RECOVERY_KEY_ENCRYPTION_KEY=64_HEX_CHARACTERS
CONNECT_CODE_HMAC_KEY=64_HEX_CHARACTERS
TENANT_INSTALLER_HMAC_KEY=64_HEX_CHARACTERS
TURN_SHARED_SECRET=64_HEX_CHARACTERS
TURN_REALM=uat-turn.hi5central.com
TURN_EXTERNAL_IP=

APP_URL=https://uat.hi5central.com
PORTAL_URL=https://uat.hi5central.com/portal
RMM_URL=https://uat-rmm.hi5central.com
ADMIN_URL=https://uat-admin.hi5central.com
API_URL=https://uat-api.hi5central.com
DOWNLOADS_URL=https://uat-downloads.hi5central.com
HELP_URL=https://help.hi5central.com
TURN_URL=turn:uat-turn.hi5central.com:3481
TURN_HOST=uat-turn.hi5central.com
MARKETING_URL=https://uat.hi5central.com
COOKIE_DOMAIN=

ITSM_ADDRESS=http://uat.hi5central.com
RMM_ADDRESS=http://uat-rmm.hi5central.com
ADMIN_ADDRESS=http://uat-admin.hi5central.com
API_ADDRESS=http://uat-api.hi5central.com
DOWNLOADS_ADDRESS=http://uat-downloads.hi5central.com
HELP_ADDRESS=
ACME_EMAIL=admin@hi5central.com

GATEWAY_HTTP_PORT=127.0.0.1:38080
GATEWAY_HTTPS_PORT=127.0.0.1:38443
TURN_LISTEN_PORT=3481
TURN_RELAY_MIN_PORT=49460
TURN_RELAY_MAX_PORT=49500

# UAT is intentionally immutable. The promotion controller replaces these
# placeholders with the exact image SHA/digest selected from Test.
CONTROL_SERVER_IMAGE=ghcr.io/dansut24/hi5central-platform-api:sha-CHANGE_ME
ITSM_IMAGE=ghcr.io/dansut24/hi5central-platform-itsm:sha-CHANGE_ME
RMM_IMAGE=ghcr.io/dansut24/hi5central-platform-rmm:sha-CHANGE_ME
ADMIN_IMAGE=ghcr.io/dansut24/hi5central-platform-admin:sha-CHANGE_ME
DOCS_IMAGE=ghcr.io/dansut24/hi5central-docs:sha-CHANGE_ME

LICENSING_SERVER_URL=https://uat-api.hi5central.com
LICENSING_PUBLIC_KEY_PEM=
LICENSING_PRIVATE_KEY_PEM=
RELEASE_OPERATOR_TOKEN=64_HEX_CHARACTERS
RELEASE_FEED_URL=https://api.hi5central.com/api/releases/v1/feed
RELEASE_SIGNING_PUBLIC_KEY_PEM=
RELEASE_SIGNING_PRIVATE_KEY_PEM=
RELEASE_FEED_SYNC_INTERVAL_MS=21600000
RELEASE_FEED_INITIAL_SYNC_DELAY_MS=45000
LICENSING_REFRESH_INTERVAL_MS=43200000
LICENSING_INITIAL_REFRESH_DELAY_MS=30000