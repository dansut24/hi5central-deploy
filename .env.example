COMPOSE_PROFILES=itsm,rmm,admin
DEPLOYMENT_MODE=self_hosted
TENANCY_MODE=single
ROOT_DOMAIN=example.internal
PRIMARY_TENANT_SLUG=local
BACKGROUND_WORKERS_ENABLED=true

POSTGRES_DB=hi5central
POSTGRES_USER=hi5central
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

MFA_ENCRYPTION_KEY=64_HEX_CHARACTERS
RMM_RECOVERY_KEY_ENCRYPTION_KEY=64_HEX_CHARACTERS
CONNECT_CODE_HMAC_KEY=64_HEX_CHARACTERS

APP_URL=https://itsm.example.internal
PORTAL_URL=https://itsm.example.internal/portal
RMM_URL=https://rmm.example.internal
ADMIN_URL=https://admin.example.internal
API_URL=https://api.example.internal
DOWNLOADS_URL=https://downloads.example.internal
TURN_URL=turn:turn.example.internal:3478
TURN_HOST=turn.example.internal
MARKETING_URL=https://itsm.example.internal
COOKIE_DOMAIN=.example.internal

ITSM_ADDRESS=itsm.example.internal
RMM_ADDRESS=rmm.example.internal
ADMIN_ADDRESS=admin.example.internal
API_ADDRESS=api.example.internal
DOWNLOADS_ADDRESS=downloads.example.internal
ACME_EMAIL=admin@example.internal

# Optional host-port overrides (useful behind an existing reverse proxy/testing).
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
TURN_LISTEN_PORT=3478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200

# Optional absolute host paths; leave relative for a normal self-contained install.
CADDYFILE_PATH=./Caddyfile
TURN_CONFIG_PATH=./secrets/turnserver.conf
TURN_SHARED_SECRET_PATH=./secrets/turn_shared_secret

CONTROL_SERVER_IMAGE=ghcr.io/dansut24/hi5central-control-server:latest
ITSM_IMAGE=ghcr.io/dansut24/hi5central-itsm:latest
RMM_IMAGE=ghcr.io/dansut24/hi5central-rmm:latest
ADMIN_IMAGE=ghcr.io/dansut24/hi5central-admin:latest

SELF_HOST_EVALUATION_PRODUCTS=itsm,rmm
SELF_HOST_EVALUATION_USER_LIMIT=10
SELF_HOST_EVALUATION_DEVICE_LIMIT=25